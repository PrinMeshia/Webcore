app WebCoreDocs {
    theme: "default"
    layout: DocsLayout
    head {
        favicon "/assets/logo.png"
        meta description="WebCore — un langage déclaratif pour construire des interfaces web, compilé en Rust."
    }
    routes {
        "/": HomePage
        "/docs": DocsPage
        "/install": InstallPage
        "/quickstart": QuickstartPage
        "/islands": IslandsPage
        "/i18n": I18nPage
        "/syntax": SyntaxPage
        "/cli": CliPage
        "/components": ComponentsPage
        "/features": FeaturesPage
        "/examples": ExamplesPage
        "/playground": PlaygroundPage
    }
}

page "home" {
    div class="hero" {
        div class="hero-badge" { "▸ WebCore 4.0 — now shipping" }
        h1 class="hero-title" {
            "Build web interfaces"
            span class="hero-accent" { " declaratively" }
        }
        p class="hero-sub" {
            "WebCore compiles "
            code { ".webc" }
            " files to semantic HTML, scoped CSS and a minimal reactive runtime."
            " One language, one compiler, zero dependencies."
        }
        div class="hero-actions" {
            link to="/docs" class="btn-hero-primary" { "Read the Docs" }
            link to="/examples" class="btn-hero-secondary" { "See Examples" }
        }
        div class="hero-snippet" {
            pre class="hero-code" {
"// Import components at build time — no runtime cost
import Counter from \"./Counter.webc\"
import Badge   from \"./Badge.webc\"

component App {
    state { status: String = \"idle\" }
    view {
        @if status === \"idle\" {
            Badge label=\"Ready\" {}
        } @else if status === \"running\" {
            Badge label=\"Running\" {}
        } @else {
            Badge label=\"Done\" {}
        }
        Counter {}
    }
}"
            }
        }
    }

    div class="stats-bar" {
        div class="stat-item" {
            span class="stat-num" { "Rust" }
            span class="stat-desc" { "PEG compiler" }
        }
        div class="stat-item" {
            span class="stat-num" { "256" }
            span class="stat-desc" { "tests" }
        }
        div class="stat-item" {
            span class="stat-num" { "islands" }
            span class="stat-desc" { "partial hydration" }
        }
        div class="stat-item" {
            span class="stat-num" { "~1 KB" }
            span class="stat-desc" { "JS prod min." }
        }
        div class="stat-item" {
            span class="stat-num" { "zero" }
            span class="stat-desc" { "dependencies" }
        }
        div class="stat-item" {
            span class="stat-num" { "i18n" }
            span class="stat-desc" { "static per locale" }
        }
    }

    section class="band reveal" {
        p class="band-eyebrow" { "What's new" }
        h2 class="band-title" { "WebCore 4.0 in four moves" }
        p class="band-sub" {
            "Ship less JavaScript, rank in every language, catch mistakes earlier, and isolate every component — with zero new dependencies."
        }
        div class="pillars" {
            div class="pillar" {
                span class="pillar-badge" { "#50" }
                div class="pillar-icon" { "🏝️" }
                h3 { "Partial hydration" }
                p {
                    "Tag a component "
                    code { "client=\"idle\"" }
                    " / "
                    code { "client=\"visible\"" }
                    " — it renders statically and hydrates on idle or scroll."
                }
                a href="/islands" { "Guide →" }
            }
            div class="pillar" {
                span class="pillar-badge" { "#45 · #46" }
                div class="pillar-icon" { "🌍" }
                h3 { "SSG i18n + hreflang" }
                p { "One static page per locale, correct lang, pre-rendered translations and alternates." }
                a href="/i18n" { "Guide →" }
            }
            div class="pillar" {
                span class="pillar-badge" { "#47–#54" }
                div class="pillar-icon" { "🛠️" }
                h3 { "Sharper DX" }
                p { "a11y lints, stable error codes, CSS source maps, friendlier grammar." }
                a href="/features" { "What's new →" }
            }
            div class="pillar" {
                span class="pillar-badge" { "#42 · #43" }
                div class="pillar-icon" { "🎯" }
                h3 { "Component-scoped" }
                p { "Reactive state and CSS are isolated per component — no collisions." }
                a href="/syntax" { "Reference →" }
            }
        }
    }

    section class="band band-tint reveal" {
        p class="band-eyebrow" { "Ship less JavaScript" }
        h2 class="band-title" { "Hydrate only what's interactive" }
        p class="band-sub" {
            "Static content stays static. Heavy widgets below the fold hydrate on their own schedule — first paint is never blocked."
        }
        div class="compare" {
            div class="compare-col" {
                div class="compare-head" { "Before — hydrate everything" }
                pre {
"page \"home\" {
    Hero {}
    HeavyChart {}     // parses + runs now
    Newsletter {}     // parses + runs now
}
// → all JS on the critical path"
                }
            }
            div class="compare-vs" { "vs" }
            div class="compare-col after" {
                div class="compare-head" { "WebCore 4.0 — islands" }
                pre {
"page \"home\" {
    Hero {}
    HeavyChart client=\"visible\" {}
    Newsletter client=\"idle\" {}
}
// → static now, hydrate on demand"
                }
            }
        }
    }

    section class="band reveal" {
        p class="band-eyebrow" { "Live · #50" }
        h2 class="band-title" { "Watch an island hydrate" }
        p class="band-sub" {
            "The component below is compiled with "
            code { "client=\"visible\"" }
            ". It stays inert until it scrolls into view — then its "
            code { "on:mount" }
            " runs and it becomes interactive. Watch the badge flip."
        }
        div class="island-spacer" { "↓ this island is lazy — its status is still \"static\" ↓" }
        div class="demo-panel" {
            div class="demo-panel-head" {
                span class="dot off" {}
                span class="demo-panel-title" { "IslandDemo · client=\"visible\"" }
            }
            div class="demo-panel-body" {
                IslandDemo client="visible" {}
            }
        }
    }

    section class="band band-tint reveal" {
        p class="band-eyebrow" { "Live · #46" }
        h2 class="band-title" { "One site, every language" }
        p class="band-sub" {
            "Switch locale live below. In a real build, "
            code { "[i18n] static" }
            " emits one pre-rendered page per language, each with the right "
            code { "lang" }
            " and "
            code { "hreflang" }
            "."
        }
        div class="demo-panel" {
            div class="demo-panel-head" {
                span class="dot on" {}
                span class="demo-panel-title" { "LocaleDemo · setLocale()" }
            }
            div class="demo-panel-body" {
                LocaleDemo {}
            }
        }
    }

    section class="band reveal" {
        p class="band-eyebrow" { "Why WebCore" }
        h2 class="band-title" { "One syntax, no boilerplate" }
        p class="band-sub" {
            "Replace HTML templates, CSS modules and JS reactivity glue with a single declarative language."
        }
        div class="feature-grid" {
            FeatureCard
                icon="⚡"
                title="Tree-shaken runtime"
                desc="The compiler emits only the JS helpers your document uses. Simple apps ship under 1.5 KB of inline script."
                tag="Performance"
            {}
            FeatureCard
                icon="🦀"
                title="Rust + PEG parser"
                desc="A Pest grammar drives a fully-typed AST. Errors carry file, line, column, a caret and a stable WCxxxx code."
                tag="Reliability"
            {}
            FeatureCard
                icon="🔒"
                title="Scoped CSS"
                desc="Each component gets a deterministic hash. Styles never leak, and scoped CSS matches the component root."
                tag="Isolation"
            {}
            FeatureCard
                icon="🌐"
                title="SPA routing"
                desc="History API navigation with parameterised routes (/post/:slug) and query params."
                tag="Routing"
            {}
            FeatureCard
                icon="🎛️"
                title="Reactive state"
                desc="ES2022 private-field State, computed vars, lifecycle hooks, inter-component events, a global store."
                tag="Reactivity"
            {}
            FeatureCard
                icon="🛡️"
                title="Strict CSP"
                desc="Expressions compile to closures — no unsafe-eval. csp=true emits a Content-Security-Policy meta tag."
                tag="Security"
            {}
        }
    }

    section class="band band-tint reveal" {
        p class="band-eyebrow" { "Try it" }
        h2 class="band-title" { "A real reactive component" }
        p class="band-sub" {
            "State, computed, "
            code { "@if" }
            " and events — compiled to vanilla JS and running right here."
        }
        LiveCounter {}
    }

    section class="band cta-band reveal" {
        p class="band-eyebrow" { "Get started" }
        h2 class="band-title" { "Build your first WebCore app" }
        p class="band-sub" { "Clone the compiler, scaffold a project, and ship a static site in minutes." }
        div class="cta-actions" {
            link to="/install" class="btn-hero-primary" { "Install" }
            link to="/quickstart" class="btn-hero-secondary" { "Quick Start" }
        }
    }
}

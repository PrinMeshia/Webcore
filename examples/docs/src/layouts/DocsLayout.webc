layout DocsLayout {
    div class="docs-shell" {
        DocsShell {}
        div class="announcement-bar" {
            span class="announcement-text" {
                strong { "WebCore 4.0 " }
                " — partial hydration (islands), per-locale SSG + hreflang, accessibility lints, stable error codes & CSS source maps"
            }
            a href="https://github.com/PrinMeshia/Webcore/blob/main/CHANGELOG.md" class="announcement-link" { "Changelog →" }
            button class="announcement-close" aria-label="Close" { "×" }
        }
        div class="scroll-progress" {}
        header class="site-header" {
            div class="header-inner" {
                link to="/" class="logo" {
                    span class="logo-mark" { "▸" }
                    span class="logo-text" { "WebCore" }
                    span class="logo-version" { "v4.0" }
                }
                nav class="site-nav" {
                    link to="/docs" { "Docs" }
                    link to="/islands" { "Guides" }
                    link to="/syntax" { "Reference" }
                    link to="/features" { "What's new" }
                    link to="/playground" { "Playground" }
                    link to="/examples" { "Examples" }
                }
                button class="nav-mobile-toggle" aria-label="Open menu" { "☰" }
            }
        }
        div class="site-body" {
            aside class="site-sidebar" {}
            main class="site-main" {
                slot content
            }
        }
        footer class="site-footer" {
            p {
                "Built with "
                strong { "WebCore" }
                " v4.0 · "
                a href="https://github.com/PrinMeshia/Webcore" { "GitHub" }
                " · "
                a href="https://github.com/PrinMeshia/Webcore/releases" { "Releases" }
                " · "
                a href="https://github.com/PrinMeshia/Webcore/blob/main/CHANGELOG.md" { "Changelog" }
            }
        }
    }
}
